---
import { withBase } from '../utils/paths';

const {
  title,
  description,
  canonical,
  ogImage = 'https://steve57000.github.io/portfolio/og-image.png',
  ogType = 'website',
  twitterDescription = description,
} = Astro.props as {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  twitterDescription?: string;
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Steve Bell',
  jobTitle: 'Développeur fullstack Java / Angular & Data Analyst junior',
  url: 'https://steve57000.github.io/portfolio/',
  sameAs: ['https://github.com/steve57000', 'https://www.linkedin.com/in/steve-bell57'],
};
---
<meta name="description" content={description} />
<meta name="author" content="Steve Bell" />
<meta name="robots" content="index, follow" />
{canonical && <link rel="canonical" href={canonical} />}
<link rel="icon" href={withBase('favicon.ico')} sizes="any" />
<link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
<link rel="manifest" href={withBase('site.webmanifest')} />
<meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b1110" media="(prefers-color-scheme: dark)" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
<title>{title}</title>
