---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { profile, skills, journey, featuredProjects } from '../data/portfolioData';
import SeoHead from '../components/SeoHead.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { withBase } from '../utils/paths';
---
<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>(()=>{const k='portfolio-theme';const r=document.documentElement;const sys=()=>window.matchMedia?.('(prefers-color-scheme: dark)').matches?'dark':'light';const saved=(()=>{try{return localStorage.getItem(k)}catch{return null}})();r.dataset.theme=saved==='dark'||saved==='light'?saved:sys();})();</script>
    <SeoHead title="CV — Steve Bell, développeur fullstack & Data Analyst junior" description="Profil, compétences, projets et parcours de Steve Bell, développeur fullstack Java / Angular et Data Analyst junior." canonical="https://steve57000.github.io/portfolio/cv/" />
  </head>
  <body>
    <Header />
    <main class="cv-page">
      <section class="cv-hero section" aria-labelledby="cv-title">
        <div>
          <p class="eyebrow">Curriculum vitæ · Profil numérique</p>
          <h1 id="cv-title">{profile.name}</h1>
          <p class="cv-hero__role">{profile.title}</p>
          <p class="cv-hero__summary">{profile.summary}</p>
          <div class="hero__actions">
            <a class="button" href={`mailto:${profile.email}`}><Icon name="mail" />Me contacter</a>
            <a class="button button--ghost" href={withBase()}><Icon name="projects" />Retour au portfolio</a>
          </div>
        </div>
        <aside class="cv-contact" aria-label="Coordonnées et profils">
          <h2>Coordonnées</h2>
          <a href={`mailto:${profile.email}`}><Icon name="mail" />{profile.email}</a>
          <span><Icon name="location" />{profile.location}</span>
          <a href={profile.links.github} target="_blank" rel="noreferrer"><Icon name="github" />GitHub</a>
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer"><Icon name="linkedin" />LinkedIn</a>
        </aside>
      </section>

      <section class="section cv-section" aria-labelledby="skills-title">
        <SectionHeader eyebrow="Expertise" title="Compétences clés" />
        <div class="skill-grid">{skills.map((group) => <article><h2 id={group.group === skills[0].group ? 'skills-title' : undefined}><span class="icon-badge icon-badge--md"><Icon name={group.icon} /></span>{group.group}</h2><ul>{group.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
      </section>

      <section class="section cv-section">
        <SectionHeader eyebrow="Sélection" title="Projets principaux" text="Cinq réalisations représentatives, de l’application métier à l’analyse de données." />
        <div class="cv-list">{featuredProjects.map((project) => <article><div><p class="eyebrow">{project.role}</p><h2>{project.title}</h2></div><p>{project.summary}</p><ul class="tags" aria-label={`Technologies ${project.title}`}>{project.stack.slice(0, 6).map((item) => <li>{item}</li>)}</ul>{project.links.repo && <a class="text-link" href={project.links.repo} target="_blank" rel="noreferrer">Consulter le dépôt</a>}</article>)}</div>
      </section>

      <section class="section cv-section">
        <SectionHeader eyebrow="Expérience & formation" title="Parcours" />
        <ol class="timeline">{journey.map((step) => <li><span>{step.period}</span><h2>{step.title}</h2><p>{step.text}</p></li>)}</ol>
      </section>

      <section class="cv-cta section" aria-labelledby="cv-contact-title">
        <div><p class="eyebrow">Contact</p><h2 id="cv-contact-title">Échangeons sur vos besoins fullstack ou data.</h2><p>Le portfolio détaille le contexte, les choix techniques et les livrables de chaque réalisation.</p></div>
        <div class="hero__actions"><a class="button" href={`mailto:${profile.email}`}><Icon name="mail" />Écrire à Steve Bell</a><a class="button button--ghost" href={withBase('#case-studies')}>Voir les case studies</a></div>
      </section>
    </main>
    <Footer />
    <script src={withBase('scripts/main.js')} defer></script>
  </body>
</html>
